{
    "dataRoles": [
        {
            "displayName": "Task",
            "name": "task",
            "kind": "Grouping",
            "description": "Task name (required)."
        },
        {
            "displayName": "Start Date",
            "name": "startDate",
            "kind": "Grouping",
            "description": "Task start date (required)."
        },
        {
            "displayName": "End Date",
            "name": "endDate",
            "kind": "Grouping",
            "description": "Task end date. Optional when Duration is supplied."
        },
        {
            "displayName": "Duration",
            "name": "duration",
            "kind": "Measure",
            "description": "Duration in days. Used when End Date is absent."
        },
        {
            "displayName": "Progress",
            "name": "progress",
            "kind": "Measure",
            "description": "Progress as 0–1 or 0–100."
        },
        {
            "displayName": "Group",
            "name": "group",
            "kind": "Grouping",
            "description": "Parent/phase for collapsible grouping."
        },
        {
            "displayName": "Resource",
            "name": "resource",
            "kind": "Grouping",
            "description": "Assignee; used for optional color-by."
        },
        {
            "displayName": "Tooltips",
            "name": "tooltips",
            "kind": "Measure",
            "description": "Extra fields shown in tooltips."
        }
    ],
    "objects": {
        "bars": {
            "displayName": "Bars",
            "properties": {
                "barHeight": {
                    "displayName": "Bar height",
                    "type": {
                        "numeric": true
                    }
                },
                "cornerRadius": {
                    "displayName": "Corner radius",
                    "type": {
                        "numeric": true
                    }
                },
                "fill": {
                    "displayName": "Bar fill",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "progressFill": {
                    "displayName": "Progress fill",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                }
            }
        },
        "labels": {
            "displayName": "Task labels",
            "properties": {
                "fontSize": {
                    "displayName": "Font size",
                    "type": {
                        "formatting": {
                            "fontSize": true
                        }
                    }
                },
                "fontFamily": {
                    "displayName": "Font family",
                    "type": {
                        "formatting": {
                            "fontFamily": true
                        }
                    }
                },
                "width": {
                    "displayName": "Label pane width",
                    "type": {
                        "numeric": true
                    }
                }
            }
        },
        "general": {
            "displayName": "General",
            "properties": {
                "colorByResource": {
                    "displayName": "Color by resource",
                    "type": {
                        "bool": true
                    }
                },
                "showTodayLine": {
                    "displayName": "Show today line",
                    "type": {
                        "bool": true
                    }
                },
                "todayLineColor": {
                    "displayName": "Today line color",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "axisGranularity": {
                    "displayName": "Axis granularity",
                    "type": {
                        "enumeration": [
                            {
                                "displayName": "Auto",
                                "value": "auto"
                            },
                            {
                                "displayName": "Day",
                                "value": "day"
                            },
                            {
                                "displayName": "Week",
                                "value": "week"
                            },
                            {
                                "displayName": "Month",
                                "value": "month"
                            },
                            {
                                "displayName": "Quarter",
                                "value": "quarter"
                            }
                        ]
                    }
                },
                "weekendShading": {
                    "displayName": "Weekend shading",
                    "type": {
                        "bool": true
                    }
                }
            }
        }
    },
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "task": {
                        "min": 1,
                        "max": 1
                    },
                    "startDate": {
                        "min": 1,
                        "max": 1
                    },
                    "endDate": {
                        "max": 1
                    },
                    "duration": {
                        "max": 1
                    },
                    "progress": {
                        "max": 1
                    },
                    "group": {
                        "max": 1
                    },
                    "resource": {
                        "max": 1
                    },
                    "tooltips": {
                        "max": 8
                    }
                }
            ],
            "table": {
                "rows": {
                    "select": [
                        {
                            "for": {
                                "in": "task"
                            }
                        },
                        {
                            "for": {
                                "in": "startDate"
                            }
                        },
                        {
                            "for": {
                                "in": "endDate"
                            }
                        },
                        {
                            "for": {
                                "in": "duration"
                            }
                        },
                        {
                            "for": {
                                "in": "progress"
                            }
                        },
                        {
                            "for": {
                                "in": "group"
                            }
                        },
                        {
                            "for": {
                                "in": "resource"
                            }
                        },
                        {
                            "for": {
                                "in": "tooltips"
                            }
                        }
                    ]
                }
            }
        }
    ],
    "privileges": [],
    "supportsHighlight": true,
    "tooltips": {
        "supportedTypes": {
            "default": true,
            "canvas": true
        },
        "roles": [
            "tooltips"
        ]
    }
}
