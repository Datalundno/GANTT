            "descriptionKey": "Role_Progress_Desc",
            "requiredTypes": [
                {
                    "numeric": true
                },
                {
                    "integer": true
                }
            ]
        },
        {
            "displayName": "Group",
            "displayNameKey": "Role_Group",
            "name": "group",
            "kind": "Grouping",
            "description": "Parent/phase for collapsible grouping.",
            "descriptionKey": "Role_Group_Desc",
            "preferredTypes": [
                {
                    "text": true
                }
            ]
        },
        {
            "displayName": "Resource",
            "displayNameKey": "Role_Resource",
            "name": "resource",
            "kind": "Grouping",
            "description": "Assignee; used for optional color-by.",
            "descriptionKey": "Role_Resource_Desc",
            "preferredTypes": [
                {
                    "text": true
                }
            ]
        },
        {
            "displayName": "Predecessor",
            "displayNameKey": "Role_Predecessor",
            "name": "predecessor",
            "kind": "Grouping",
            "description": "Upstream task name for finish-to-start dependency arrows (Lab).",
