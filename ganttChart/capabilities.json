    "dataViewMappings": [
        {
            "conditions": [
                {
                    "task": { "min": 1, "max": 1 },
                    "startDate": { "min": 0, "max": 1 },
                    "endDate": { "min": 0, "max": 1 },
                    "duration": { "min": 0, "max": 1 },
                    "progress": { "max": 1 },
                    "group": { "max": 1 },
                    "resource": { "max": 1 },
                    "predecessor": { "max": 1 },
                    "tooltipFields": { "max": 8 }
                }
            ],
            "table": {
                "rows": {
                    "select": [
                        { "for": { "in": "task" } },
                        { "for": { "in": "startDate" } },
                        { "for": { "in": "endDate" } },
                        { "bind": { "to": "duration" } },
                        { "bind": { "to": "progress" } },
                        { "for": { "in": "group" } },
                        { "for": { "in": "resource" } },
                        { "for": { "in": "predecessor" } },
                        { "for": { "in": "tooltipFields" } }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 30000
                        }
                    }
                }
            }
        }
    ],
    "privileges": [],
    "supportsHighlight": true,
    "supportsMultiVisualSelection": true,
    "supportsLandingPage": true,
    "supportsEmptyDataView": true,
    "supportsKeyboardFocus": true,
    "tooltips": {
        "supportedTypes": {
            "default": true,
            "canvas": true
        },
        "roles": [
            "tooltipFields"
        ]
    }
}
