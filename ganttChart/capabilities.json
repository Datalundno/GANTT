{
    "dataRoles": [
        {
            "displayName": "Task",
            "name": "task",
            "kind": "Grouping",
            "description": "Task name (required).",
            "preferredTypes": [
                {
                    "text": true
                }
            ]
        },
        {
            "displayName": "Start Date",
            "name": "startDate",
            "kind": "GroupingOrMeasure",
            "description": "Task start date (required)."
        },
        {
            "displayName": "End Date",
            "name": "endDate",
            "kind": "GroupingOrMeasure",
            "description": "Task end date. Optional when Duration is supplied."
        },
        {
            "displayName": "Duration",
            "name": "duration",
            "kind": "Measure",
            "description": "Duration in days. Used when End Date is absent.",
            "requiredTypes": [
                {
                    "numeric": true
                },
                {
                    "integer": true
                }
            ]
        },
        {
            "displayName": "Progress",
            "name": "progress",
            "kind": "Measure",
            "description": "Progress as 0–1 or 0–100.",
            "requiredTypes": [
                {
                    "numeric": true
                },
                {
                    "integer": true
                }
            ]
        },
        {
            "displayName": "Group",
            "name": "group",
            "kind": "Grouping",
            "description": "Parent/phase for collapsible grouping.",
            "preferredTypes": [
                {
                    "text": true
                }
            ]
        },
        {
            "displayName": "Resource",
            "name": "resource",
            "kind": "Grouping",
            "description": "Assignee; used for optional color-by.",
            "preferredTypes": [
                {
                    "text": true
                }
            ]
        },
        {
            "displayName": "Tooltips",
            "name": "tooltipFields",
            "kind": "Grouping",
            "description": "Extra fields shown in tooltips."
        }
    ],
    "objects": {
        "bars": {
            "displayName": "Bars",
            "properties": {
                "barHeight": {
                    "displayName": "Bar height",
                    "type": {
                        "numeric": true
                    }
                },
                "cornerRadius": {
                    "displayName": "Corner radius",
                    "type": {
                        "numeric": true
                    }
                },
                "fill": {
                    "displayName": "Bar fill",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "progressFill": {
                    "displayName": "Progress fill",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                }
            }
        },
        "labels": {
            "displayName": "Task labels",
            "properties": {
                "fontSize": {
                    "displayName": "Font size",
                    "type": {
                        "formatting": {
                            "fontSize": true
                        }
                    }
                },
                "fontFamily": {
                    "displayName": "Font family",
                    "type": {
                        "formatting": {
                            "fontFamily": true
                        }
                    }
                },
                "width": {
                    "displayName": "Label pane width",
                    "type": {
                        "numeric": true
                    }
                }
            }
        },
        "general": {
            "displayName": "General",
            "properties": {
                "colorByResource": {
                    "displayName": "Color by resource",
                    "type": {
                        "bool": true
                    }
                },
                "showTodayLine": {
                    "displayName": "Show today line",
                    "type": {
                        "bool": true
                    }
                },
                "todayLineColor": {
                    "displayName": "Today line color",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "axisGranularity": {
                    "displayName": "Axis granularity",
                    "type": {
                        "enumeration": [
                            {
                                "displayName": "Auto",
                                "value": "auto"
                            },
                            {
                                "displayName": "Day",
                                "value": "day"
                            },
                            {
                                "displayName": "Week",
                                "value": "week"
                            },
                            {
                                "displayName": "Month",
                                "value": "month"
                            },
                            {
                                "displayName": "Quarter",
                                "value": "quarter"
                            }
                        ]
                    }
                },
                "weekendShading": {
                    "displayName": "Weekend shading",
                    "type": {
                        "bool": true
                    }
                }
            }
        }
    },
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "task": { "min": 1, "max": 1 },
                    "startDate": { "min": 0, "max": 1 },
                    "endDate": { "min": 0, "max": 1 },
                    "duration": { "max": 0 },
                    "progress": { "max": 1 },
                    "group": { "max": 1 },
                    "resource": { "max": 1 },
                    "tooltipFields": { "max": 8 }
                },
                {
                    "task": { "min": 1, "max": 1 },
                    "startDate": { "min": 0, "max": 1 },
                    "endDate": { "max": 0 },
                    "duration": { "min": 0, "max": 1 },
                    "progress": { "max": 1 },
                    "group": { "max": 1 },
                    "resource": { "max": 1 },
                    "tooltipFields": { "max": 8 }
                }
            ],
            "table": {
                "rows": {
                    "select": [
                        { "for": { "in": "task" } },
                        { "for": { "in": "startDate" } },
                        { "for": { "in": "endDate" } },
                        { "bind": { "to": "duration" } },
                        { "bind": { "to": "progress" } },
                        { "for": { "in": "group" } },
                        { "for": { "in": "resource" } },
                        { "for": { "in": "tooltipFields" } }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 30000
                        }
                    }
                }
            }
        }
    ],
    "privileges": [],
    "supportsHighlight": true,
    "tooltips": {
        "supportedTypes": {
            "default": true,
            "canvas": true
        },
        "roles": [
            "tooltipFields"
        ]
    }
}
